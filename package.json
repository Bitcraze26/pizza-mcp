{
  "name": "pizza-mcp",
  "version": "1.0.0",
  "description": "Server MCP per calcolare le dosi dell'impasto della pizza (farine, acqua, sale, lievito)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pizza-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "pizza",
    "dough",
    "impasto",
    "calculator"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
